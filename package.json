{
  "name": "ai-passport-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser shell and WASM runtime host for AI Passport QEMU",
  "scripts": {
    "build": "npm run prepare:emulator && node tools/build-site.mjs",
    "prepare:emulator": "node tools/verify-board-runtime.mjs",
    "start": "node server.mjs --allow-local-firmware-upload",
    "start:dist": "node dist/server.mjs",
    "verify:release": "node tools/verify-site.mjs",
    "test": "node --test",
    "playground:prepare": "cd playground && npm ci && npm run build:editor && python3 setup.py && python3 build.py --prepare",
    "playground:start": "cd playground && python3 server.py",
    "playground:test": "cd playground && node smoke.mjs",
    "playground:editor": "cd playground && npm run build:editor",
    "playground:export": "cd playground && python3 export_static.py",
    "build:pages": "npm run prepare:emulator && node tools/build-pages.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4"
  }
}
